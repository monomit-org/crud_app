              "raw": "{{baseUrl}}/api/users?search=john",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {
                  "key": "search",
                  "value": "john",
                  "description": "Search term for name or email"
                }
              ]
            }
          },
          "response": []
